# ====================================
# AI Career Companion - 环境变量配置
# ====================================
# 复制此文件为 .env.local 并填入真实值

# --- Auth.js v5 ---
# 生成命令: openssl rand -base64 32
# 必须！缺失时服务将拒绝启动
AUTH_SECRET=your-auth-secret-here

# 生产环境填入实际域名，开发环境用 http://localhost:3000
AUTH_TRUST_HOST=true
NEXTAUTH_URL=http://localhost:3000

# 渠道二维码内的站点域名（生产填 https://你的域名）；不填时用 NEXTAUTH_URL/请求头推断
PUBLIC_BASE_URL=http://localhost:3000

# --- 管理后台子域名（单应用 Host 路由）---
# 生产设以下变量，启用子域名后台；测试端/本地不设则相关逻辑自动失效，不影响部署
# CHANNEL_DOMAIN=channel.aihr.top            # 渠道后台子域名（服务端鉴权白名单用）
# NEXT_PUBLIC_CHANNEL_DOMAIN=channel.aihr.top # 同上，客户端判断当前是否在子域名
# NEXT_PUBLIC_MAIN_DOMAIN=https://aihr.top    # 主域完整 URL，子域名下短链指向此处
# COOKIE_DOMAIN=.aihr.top                     # 登录 cookie 域，带点前缀覆盖主域及所有子域；测试端不设

# --- 数据库 ---
# 本地开发：先启动 docker compose -f docker-compose.dev.yml up -d
DATABASE_URL="mysql://root:root123@localhost:3306/xinzang_dev"

# --- DeepSeek API ---
# 代码兼容 OPENAI_API_KEY 和 DEEPSEEK_API_KEY 两种变量名（优先读 DEEPSEEK_API_KEY）
# CloudBase 控制台使用 OPENAI_API_KEY
OPENAI_API_KEY=your-deepseek-api-key
AI_API_URL=https://api.deepseek.com/v1
AI_MODEL=deepseek-chat

# --- 支付网关 ---
# Mock 支付模式：本地开发设为 true 即可
# 生产构建默认硬禁用；CloudBase staging 需同时设 MOCK_PAYMENT_ENABLED=true 和 DEPLOY_ENV=staging
# 火山引擎生产内测：需同时设 MOCK_PAYMENT_ENABLED=true 和 ALLOW_MOCK_IN_PRODUCTION=true（接好真实支付后立即关闭）
# MOCK_PAYMENT_ENABLED=true

# 微信支付 H5
# WXPAY_APP_ID=
# WXPAY_MCH_ID=
# WXPAY_API_V3_KEY=
# WXPAY_SERIAL_NO=
# WXPAY_PRIVATE_KEY=
# 微信支付平台证书公钥（PEM 格式，用于验证回调签名，非 API v3 密钥）
# WXPAY_PLATFORM_CERT_PEM=
# WXPAY_NOTIFY_URL=
# WXPAY_H5_RETURN_URL=

# 支付宝手机网站支付
# ALIPAY_APP_ID=
# ALIPAY_PRIVATE_KEY=
# ALIPAY_PUBLIC_KEY=
# ALIPAY_NOTIFY_URL=
# ALIPAY_RETURN_URL=

# --- 安全配置 ---
# 可信代理数量（影响 X-Forwarded-For 取值，CloudBase 通常为 1）
# TRUSTED_PROXY_COUNT=1

# 维护任务密钥（定时调用 /api/maintenance 时需要此密钥）
# CRON_SECRET=your-cron-secret-here

# --- 应用配置 ---
APP_NAME="AI Career Companion"
FREE_TRIAL_COUNT=3
RATE_LIMIT_PER_MINUTE=10

# 聊天历史保留天数（超过后自动清理，默认 90）
# CHAT_HISTORY_RETENTION_DAYS=90

# Mock 支付: 需设置 MOCK_PAYMENT_ENABLED=true，点击"确认支付(模拟)"即可
# 注册验证码: Mock 模式下 API 返回验证码，前端显示"验证码已发送（模拟：XXXXXX）"
