# ====================================
# AI Career Companion - 环境变量配置
# ====================================
# 复制此文件为 .env.local 并填入真实值

# --- Auth.js v5 ---
# 生成命令: openssl rand -base64 32
AUTH_SECRET=your-auth-secret-here

# 生产环境填入实际域名，开发环境用 http://localhost:3000
AUTH_TRUST_HOST=true
NEXTAUTH_URL=http://localhost:3000

# --- 数据库 ---
# SQLite 开发环境（文件路径相对于项目根目录）
DATABASE_URL="file:./dev.db"

# --- DeepSeek API ---
DEEPSEEK_API_KEY=your-deepseek-api-key
AI_API_URL=https://api.deepseek.com/v1
AI_MODEL=deepseek-chat

# --- 支付网关 (M1 Mock 模式，生产环境对接) ---
# 微信支付 H5
# WXPAY_APP_ID=
# WXPAY_MCH_ID=
# WXPAY_API_V3_KEY=
# WXPAY_SERIAL_NO=
# WXPAY_PRIVATE_KEY=
# WXPAY_NOTIFY_URL=
# WXPAY_H5_RETURN_URL=

# 支付宝手机网站支付
# ALIPAY_APP_ID=
# ALIPAY_PRIVATE_KEY=
# ALIPAY_PUBLIC_KEY=
# ALIPAY_NOTIFY_URL=
# ALIPAY_RETURN_URL=

# --- 应用配置 ---
APP_NAME="AI Career Companion"
FREE_TRIAL_COUNT=3
RATE_LIMIT_PER_MINUTE=10

# ====================================
# 测试账号（Docker 构建时自动预置到数据库）
# ====================================
# 这些账号由 prisma/seed-test-users.ts 创建，Dockerfile 构建阶段自动执行
# 也可手动运行: npx tsx prisma/seed-test-users.ts
#
# ┌──────────┬─────────────────────────┬────────────┐
# │ 类型     │ 账号                     │ 密码       │
# ├──────────┼─────────────────────────┼────────────┤
# │ 手机(免费)│ 13800000001             │ test1234   │
# │ 邮箱(免费)│ test@aiccompanion.com   │ test1234   │
# │ 手机(会员)│ 13800000002             │ premium1234│
# └──────────┴─────────────────────────┴────────────┘
#
# Mock 支付: 不需要验证码，在支付页面点击"确认支付(模拟)"即可
# 注册验证码: Mock 模式下 API 返回验证码，前端显示"验证码已发送（模拟：XXXXXX）"
