# ====================================
# AI Career Companion - 环境变量配置
# ====================================
# 复制此文件为 .env.local 并填入真实值

# --- Auth.js v5 ---
# 生成命令: openssl rand -base64 32
AUTH_SECRET=your-auth-secret-here

# 生产环境填入实际域名，开发环境用 http://localhost:3000
AUTH_TRUST_HOST=true
NEXTAUTH_URL=http://localhost:3000

# --- 数据库 ---
# SQLite 开发环境（文件路径相对于项目根目录）
DATABASE_URL="file:./dev.db"

# --- DeepSeek API ---
# 代码兼容 OPENAI_API_KEY 和 DEEPSEEK_API_KEY 两种变量名（优先读 DEEPSEEK_API_KEY）
# CloudBase 控制台使用 OPENAI_API_KEY
OPENAI_API_KEY=your-deepseek-api-key
AI_API_URL=https://api.deepseek.com/v1
AI_MODEL=deepseek-chat

# --- 支付网关 (M1 Mock 模式，生产环境对接) ---
# 微信支付 H5
# WXPAY_APP_ID=
# WXPAY_MCH_ID=
# WXPAY_API_V3_KEY=
# WXPAY_SERIAL_NO=
# WXPAY_PRIVATE_KEY=
# WXPAY_NOTIFY_URL=
# WXPAY_H5_RETURN_URL=

# 支付宝手机网站支付
# ALIPAY_APP_ID=
# ALIPAY_PRIVATE_KEY=
# ALIPAY_PUBLIC_KEY=
# ALIPAY_NOTIFY_URL=
# ALIPAY_RETURN_URL=

# --- 应用配置 ---
APP_NAME="AI Career Companion"
FREE_TRIAL_COUNT=3
RATE_LIMIT_PER_MINUTE=10

# ====================================
# 测试账号（Docker 构建时自动预置到数据库）
# ====================================
# 统一密码 12345678
#
# 手机(免费)
# 13821668570
#
# 邮箱(免费)
# t@t.com
