# ====================================
# AI Career Companion - 环境变量配置
# ====================================
# 复制此文件为 .env.local 并填入真实值

# --- Auth.js v5 ---
# 生成命令: openssl rand -base64 32
# 必须！缺失时服务将拒绝启动
AUTH_SECRET=your-auth-secret-here

# 生产环境填入实际域名，开发环境用 http://localhost:3000
AUTH_TRUST_HOST=true
NEXTAUTH_URL=http://localhost:3000

# --- 数据库 ---
# SQLite 开发环境（文件路径相对于项目根目录）
DATABASE_URL="file:./dev.db"

# --- DeepSeek API ---
# 代码兼容 OPENAI_API_KEY 和 DEEPSEEK_API_KEY 两种变量名（优先读 DEEPSEEK_API_KEY）
# CloudBase 控制台使用 OPENAI_API_KEY
OPENAI_API_KEY=your-deepseek-api-key
AI_API_URL=https://api.deepseek.com/v1
AI_MODEL=deepseek-chat

# --- 支付网关 ---
# Mock 支付模式（开发环境自动开启，生产环境需显式设为 true 才启用）
# 生产环境切勿设置此项，否则用户可免费获取会员
# MOCK_PAYMENT_ENABLED=true

# 微信支付 H5
# WXPAY_APP_ID=
# WXPAY_MCH_ID=
# WXPAY_API_V3_KEY=
# WXPAY_SERIAL_NO=
# WXPAY_PRIVATE_KEY=
# 微信支付平台证书公钥（PEM 格式，用于验证回调签名，非 API v3 密钥）
# WXPAY_PLATFORM_CERT_PEM=
# WXPAY_NOTIFY_URL=
# WXPAY_H5_RETURN_URL=

# 支付宝手机网站支付
# ALIPAY_APP_ID=
# ALIPAY_PRIVATE_KEY=
# ALIPAY_PUBLIC_KEY=
# ALIPAY_NOTIFY_URL=
# ALIPAY_RETURN_URL=

# --- 安全配置 ---
# 可信代理数量（影响 X-Forwarded-For 取值，CloudBase 通常为 1）
# TRUSTED_PROXY_COUNT=1

# 维护任务密钥（定时调用 /api/maintenance 时需要此密钥）
# CRON_SECRET=your-cron-secret-here

# --- 应用配置 ---
APP_NAME="AI Career Companion"
FREE_TRIAL_COUNT=3
RATE_LIMIT_PER_MINUTE=10

# 聊天历史保留天数（超过后自动清理，默认 90）
# CHAT_HISTORY_RETENTION_DAYS=90

# Mock 支付: 需设置 MOCK_PAYMENT_ENABLED=true，点击"确认支付(模拟)"即可
# 注册验证码: Mock 模式下 API 返回验证码，前端显示"验证码已发送（模拟：XXXXXX）"
