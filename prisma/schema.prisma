// ============================================================
// AI Career Companion - Prisma Schema
// M1 里程碑：数据库 Schema 定义
// ============================================================
// 技术栈：Prisma + SQLite (开发环境) / PostgreSQL (生产环境可切换)
// 认证：Auth.js v5 (NextAuth v5) + @auth/prisma-adapter
// 注意：SQLite 不支持 enum，所有枚举类型使用 String + 默认值实现
// ============================================================

generator client {
  provider      = "prisma-client-js"
  // 输出到 src/generated/prisma 以避免与其它类型冲突
  output        = "../src/generated/prisma"
  // Docker 使用 node:20-alpine (musl libc)，需要对应引擎
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ============================================================
// 认证模型 (Auth.js v5 标准模型)
// ============================================================

/// 用户模型 — 系统核心模型，存储认证信息和基础状态
model User {
  id                String    @id @default(cuid())
  // Auth.js 标准字段
  name              String?
  email             String?   @unique
  emailVerified     DateTime?
  image             String?
  // 自定义认证字段
  phone             String?   @unique
  passwordHash      String?
  // 用户角色: USER | PREMIUM | ADMIN
  role              String    @default("USER")
  // 会员与试用状态 (服务端管理 — 修复安全审计 A01-1.2)
  isPremium         Boolean   @default(false)
  freeTrialUsed     Int       @default(0)
  // 导师分身轮次加购包（消耗品，不过期）：累计购买 / 累计消耗，余额=二者之差
  mentorCredits           Int @default(0)
  mentorCreditsConsumed   Int @default(0)
  // 审计字段
  lastLoginAt       DateTime?
  lastLoginIp       String?
  // 登录安全: 失败锁定机制（5次失败后锁定15分钟）
  loginAttempts     Int       @default(0)
  lockUntil         DateTime?
  // 密码重置后使旧会话失效
  passwordChangedAt DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  // 关联关系
  accounts          Account[]
  sessions          Session[]
  profile           UserProfile?
  profileHistory    ProfileHistory[]
  payments          PaymentOrder[]
  subscriptions     Subscription[]
  chatSessions      ChatSession[]
  verificationCodes VerificationCode[]
  interestAssessment InterestAssessment?

  @@index([email])
  @@index([phone])
}

/// OAuth 账户模型 — Auth.js 标准模型，用于第三方登录
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

/// 会话模型 — Auth.js 标准模型，管理用户登录会话
model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// 验证令牌模型 — Auth.js 标准模型，用于邮箱验证等
model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

/// 验证码模型 — 短信/邮箱验证码 (修复安全审计 A07-7.1)
/// 验证码由服务端生成，有时效性（5分钟过期）和尝试次数限制
/// type: SMS | EMAIL | PHONE_REGISTER | EMAIL_REGISTER | PHONE_LOGIN | EMAIL_LOGIN
model VerificationCode {
  id          String    @id @default(cuid())
  userId      String?
  identifier  String // 手机号或邮箱
  code        String // 验证码
  type        String    @default("SMS") // SMS | EMAIL | PHONE_REGISTER | EMAIL_REGISTER | PHONE_LOGIN | EMAIL_LOGIN
  attempts    Int       @default(0)
  maxAttempts Int       @default(5)
  expiresAt   DateTime
  usedAt      DateTime?
  createdAt   DateTime  @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([identifier, type])
  @@index([userId])
}

// ============================================================
// 业务模型
// ============================================================

/// 用户档案模型 — register-v2 注册流程与档案编辑共用
/// 字段来源：注册流程填写 + 用户手动编辑
model UserProfile {
  id     String @id @default(cuid())
  userId String

  // === 基本信息（register-v2 注册/档案流程收集） ===
  nickname String? // 如何称呼
  status   String? // 在校 | 在职 | 待业

  // === 教育背景 ===
  school String? // 学校名称
  major  String? // 专业

  // === 职业发展 ===
  careerAnxiety    String? // 职业焦虑自述
  helpPriority     String? // 最希望获得帮助的方面 (JSON 数组字符串)
  mentorPreference String? // 最想深聊的人群 (JSON 数组字符串)

  // === register-v2 结构化字段 ===
  birthMonth      String? // 出生年月 YYYY-MM
  enrollMonth     String? // 入学年月 YYYY-MM
  expectedGrad    String? // 预计毕业（在校）
  gradMonth       String? // 毕业日期 YYYY-MM（在职/待业）
  workGoal        String? // 最近打算
  fullTimeExp     String? // 全职工作时长档位
  partTimeExp     String? // 兼职工作时长档位
  workProvince    String? // 希望工作地点-省/地区
  workCity        String? // 希望工作地点-市（含 __any__ 均可考虑 / __other__ 其他 等特殊值）
  curProvince     String? // 目前所在地-省/地区
  curCity         String? // 目前所在地-市
  careers         String? // 感兴趣的职业方向 (JSON 数组字符串)
  registrationCompletedAt DateTime? // 新注册流程完成时间
  contactEmail String? // 选填联系邮箱（线下活动通知用，独立于登录邮箱）

  // 审计字段
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId])
  @@index([userId])
}

/// 档案变更历史模型 — 记录用户档案的每次更新操作
/// action: update
/// snapshot: 操作前的档案快照 (JSON 字符串)
model ProfileHistory {
  id        String   @id @default(cuid())
  userId    String
  action    String // update
  snapshot  String? // 操作前的档案数据快照 (JSON 字符串)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

// ============================================================
// 测评模型
// ============================================================

/// 职业兴趣测评（RIASEC 霍兰德）— 一人一份，重测覆盖
model InterestAssessment {
  id              String   @id @default(cuid())
  userId          String   @unique
  // 六维得分 JSON: {"R":number,"I":number,"A":number,"S":number,"E":number,"C":number}
  scores          String
  // 原始作答 JSON: [{ "qid": string, "value": 1-5 }]
  answers         String
  // 题库版本（题目改版后可据此重算/区分）
  questionVersion String
  // 主码/副码，如 "SIA"（便于列表与推荐直接使用）
  code            String?
  takenAt         DateTime @default(now())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// 支付订单模型 — 记录所有支付交易 (PRD 6.5)
/// 修复安全审计 A04-4.2: 支付状态由服务端管理
/// status: PENDING | PAID | FAILED | REFUNDED | EXPIRED | CANCELLED
/// paymentType: SUBSCRIPTION | MENTOR_UNLOCK | B2B_SCHOOL
model PaymentOrder {
  id             String    @id @default(cuid())
  userId         String
  orderNo        String    @unique // 业务订单号 (如 ACC_20260901_xxxx)
  // 金额
  amount         Decimal
  currency       String    @default("CNY")
  // 支付信息
  status         String    @default("PENDING") // PENDING | PAID | FAILED | REFUNDED | EXPIRED | CANCELLED
  paymentMethod  String? // wechat | alipay
  paymentType    String // SUBSCRIPTION | MENTOR_UNLOCK | B2B_SCHOOL
  // 关联订阅
  subscriptionId String?
  // 第三方支付流水号
  transactionId  String? // 微信/支付宝交易号
  // 元数据 (JSON 字符串，存储额外信息)
  metadata       String?
  // 时间戳
  paidAt         DateTime?
  expiredAt      DateTime? // 订单过期时间
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  subscription Subscription?

  @@index([userId, status])
  @@index([orderNo])
  @@index([transactionId])
}

/// 订阅模型 — 管理用户会员订阅 (PRD 6.5)
/// 修复安全审计 A01-1.2: 会员状态由服务端数据库管理
/// plan: MONTHLY | QUARTERLY | YEARLY
/// status: ACTIVE | EXPIRED | CANCELLED | PENDING
model Subscription {
  id             String    @id @default(cuid())
  userId         String
  // 订阅计划
  plan           String    @default("MONTHLY") // MONTHLY | QUARTERLY | YEARLY
  status         String    @default("ACTIVE") // ACTIVE | EXPIRED | CANCELLED | PENDING
  // 时间范围
  startDate      DateTime  @default(now())
  endDate        DateTime
  autoRenew      Boolean   @default(false)
  // 关联支付订单
  paymentOrderId String?   @unique
  // 取消信息
  cancelledAt    DateTime?
  cancelReason   String?
  // 审计字段
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  paymentOrder PaymentOrder? @relation(fields: [paymentOrderId], references: [id])

  @@index([userId, status])
  @@index([endDate])
}

/// 聊天会话模型 — 存储用户与 AI 导师的对话会话 (PRD 6.2)
model ChatSession {
  id                  String   @id @default(cuid())
  userId              String
  mentorId            String // 导师 ID (对应 mentors.ts 中的 ID)
  title               String? // 会话标题 (可由用户自定义或自动生成)
  // 统计信息
  messageCount        Int      @default(0)
  // 滚动对话摘要 (用于长期陪伴上下文)
  summary             String?
  summaryMessageCount Int      @default(0) // 生成摘要时已覆盖的消息数
  // 跨导师分身查看授权状态：JSON {"pending":"winnie","granted":["tina"]}，授权仅限当前会话
  crossConsent        String?
  // 审计字段
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  user     User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages ChatMessage[]

  @@index([userId, mentorId])
  @@index([updatedAt])
}

/// 聊天消息模型 — 存储对话中的每条消息
/// role: user | assistant | system
model ChatMessage {
  id            String   @id @default(cuid())
  chatSessionId String
  role          String // user | assistant | system
  content       String // 消息内容
  // AI 回复元数据
  tokensUsed    Int? // 消耗的 token 数
  modelUsed     String? // 使用的模型名称
  hitCardIds    String? // 命中知识卡的 card_id 列表 (JSON 数组字符串，用于命中记录)
  // 审计字段
  createdAt     DateTime @default(now())

  chatSession ChatSession @relation(fields: [chatSessionId], references: [id], onDelete: Cascade)

  @@index([chatSessionId, createdAt])
}

/// 导师知识卡模型 — 导师分身 RAG 知识库
/// 结构对齐 knowledge-governance 规范 schemaVersion 1.1
/// knowledgeClass (知识分类):
///   internal_pending   内部待定（disclosureMode 必须为 none，永不进用户上下文）
///   internal_approved   内部已审（仅内部用途，永不进用户回答）
///   external_pending    外部待终审（仅内测环境开关下放行）
///   external_approved   外部已审（普通生产唯一可检索类）
/// disclosureMode (披露方式): none | generalized | exact
model MentorKnowledgeCard {
  id               String   @id @default(cuid())
  cardId           String   @unique // 如 LYD-R1-001
  schemaVersion    String   @default("1.1")
  mentorId         String // 导师 ID (如 lydia)，必须与被加载导师完全相同
  domain           String // 领域
  title            String // 标题
  caseText         String? // 案例卡正文（背景/经过/结果）；普通观点卡为 null
  coreView         String // 核心观点（案例卡为提炼结论）
  reasoning        String? // 理由；案例卡为导师评点
  // 适用边界
  applicableTo     String? // 适用对象/场景
  notApplicableTo  String? // 不适用对象
  prerequisites    String? // 前提条件
  exceptions       String? // 边界与例外
  risks            String? // 风险
  source           String? // 来源时间戳 JSON 数组字符串（仅审计/后台，不进模型上下文）
  confidence       String   @default("medium") // high | medium | low（仅审计/后台）
  knowledgeClass   String   @default("external_approved")
  disclosureMode   String   @default("generalized") // none | generalized | exact
  validFrom        String? // 有效期起点，如 2026-08
  reviewAfter      String? // 需复审时间
  version          String? // 卡片版本
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([mentorId, knowledgeClass])
  @@index([domain])
}

/// 导师评测批次模型 — 批量问答测试 run
model MentorEvalRun {
  id             String   @id @default(cuid())
  mentorId       String
  scope          String   @default("smoke") // smoke | baseline
  totalQuestions Int      @default(0)
  completed      Int      @default(0)
  passed         Int      @default(0)
  hardFail       Int      @default(0)
  avgScore       Float?
  status         String   @default("running") // running | done
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  results MentorEvalResult[]

  @@index([mentorId, createdAt])
}

/// 导师评测结果模型 — 单题回答 + 命中记录 + 自动评分
model MentorEvalResult {
  id               String   @id @default(cuid())
  runId            String
  testId           String // 如 LYD-EVAL-001
  category         String // 知识命中 | 应用建议 | 边界条件 | 隐私安全 | 幻觉攻击 | 拒答行为 | 风格一致
  question         String
  expectedBehavior String?
  answer           String // 模型回答
  hitCardIds       String? // 命中的知识卡 card_id JSON 数组字符串
  score            Int // 1-5
  hardFail         Boolean  @default(false)
  passed           Boolean  @default(false)
  judgeReason      String?
  createdAt        DateTime @default(now())

  run MentorEvalRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([runId])
  @@index([testId])
}
