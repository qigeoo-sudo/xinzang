{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "knowledge_card.schema.json",
  "title": "Mentor Knowledge Card",
  "description": "导师知识卡当前规范结构。案例卡使用caseText保存案例本身，reasoning保存导师评点。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "cardId",
    "mentorId",
    "domain",
    "title",
    "caseText",
    "coreView",
    "reasoning",
    "applicableTo",
    "notApplicableTo",
    "prerequisites",
    "exceptions",
    "risks",
    "source",
    "confidence",
    "knowledgeClass",
    "disclosureMode",
    "validFrom",
    "reviewAfter",
    "version"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.1"
    },
    "cardId": {
      "type": "string",
      "minLength": 1
    },
    "mentorId": {
      "type": "string",
      "minLength": 1
    },
    "domain": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "description": "不重复导师姓名。"
    },
    "caseText": {
      "type": ["string", "null"],
      "minLength": 1,
      "description": "普通观点卡为null；案例卡保存案例本身，包括必要背景、经过和结果。"
    },
    "coreView": {
      "type": "string",
      "minLength": 1,
      "description": "一句话核心观点；案例卡中为案例提炼结论。"
    },
    "reasoning": {
      "type": ["string", "null"],
      "description": "普通观点卡保存理由；案例卡保存导师评点、判断理由和建议。"
    },
    "applicableTo": {
      "type": ["string", "null"]
    },
    "notApplicableTo": {
      "type": ["string", "null"]
    },
    "prerequisites": {
      "type": ["string", "null"]
    },
    "exceptions": {
      "type": ["string", "null"]
    },
    "risks": {
      "type": ["string", "null"]
    },
    "source": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "confidence": {
      "type": "string",
      "enum": ["low", "medium", "high"]
    },
    "knowledgeClass": {
      "type": "string",
      "enum": [
        "internal_pending",
        "internal_approved",
        "external_pending",
        "external_approved"
      ]
    },
    "disclosureMode": {
      "type": "string",
      "enum": ["none", "generalized", "exact"]
    },
    "validFrom": {
      "type": ["string", "null"]
    },
    "reviewAfter": {
      "type": ["string", "null"]
    },
    "version": {
      "type": ["string", "null"]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "knowledgeClass": {
            "enum": ["internal_pending", "internal_approved"]
          }
        },
        "required": ["knowledgeClass"]
      },
      "then": {
        "properties": {
          "disclosureMode": {
            "const": "none"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "knowledgeClass": {
            "enum": ["external_pending", "external_approved"]
          }
        },
        "required": ["knowledgeClass"]
      },
      "then": {
        "properties": {
          "disclosureMode": {
            "enum": ["generalized", "exact"]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "caseText": {
            "type": "string"
          }
        },
        "required": ["caseText"]
      },
      "then": {
        "properties": {
          "reasoning": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  ]
}
